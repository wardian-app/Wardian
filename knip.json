{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/test/setup.ts",
    "src/**/*.test.{ts,tsx}",
    "e2e/**/*.{ts,tsx}",
    "e2e-native/**/*.mjs",
    "scripts/**/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/test/**!",
    "!src/features/workbench/workbenchTestUtils.ts!",
    "!src/features/workbench/workbenchSelectors.ts!",
    "!src/config/viteDevServerHeaders.ts!",
    "!src/config/viteWatchIgnored.ts!"
  ],
  "ignoreExportsUsedInFile": true,
  "tags": [
    "-ipcContract"
  ]
}
