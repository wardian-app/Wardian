          "label": "Output schema",
          "required": false,
          "multiple": false
        }
      ],
      "inputs": [
        {
          "id": "in",
          "label": "In"
        }
      ],
      "outputs": [
        {
          "id": "out",
          "label": "Out"
        }
      ],
      "version": 1
    },
    {
      "id": "decision",
      "kind": "agent",
      "category": "Agent",
      "label": "Decision",
      "icon": "git-branch",
