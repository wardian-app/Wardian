        {
          "id": "prompt",
          "kind": "prompt",
          "label": "Prompt",
          "required": true,
          "multiple": false
        },
        {
          "id": "choices",
          "kind": "branch_port",
          "label": "Choices",
          "required": true,
          "multiple": true,
          "help": "Unique non-empty port ids the agent may choose between; each must connect to an outgoing edge."
        }
      ],
      "inputs": [
        {
          "id": "in",
          "label": "In"
        }
      ],
      "outputs": [],
      "outputs_from_field": "choices",
      "version": 1
    },
    {
      "id": "branch",
      "kind": "engine",
      "category": "Control",
      "label": "Branch",
      "icon": "git-fork",
      "description": "Deterministic condition on run state.",
      "supported": true,
      "fields": [
        {
          "id": "condition",
          "kind": "text",
          "label": "Condition",
          "required": true,
          "multiple": false,
