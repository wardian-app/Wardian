        {
          "id": "agent_id",
          "kind": "text",
          "label": "Memory agent",
          "required": true,
          "multiple": false,
          "default": "{{trigger.output.agent_id}}",
          "help": "Engine-owned invocation agent; only {{trigger.output.agent_id}} is accepted."
